# Copy to .env and fill in. .env is git-ignored and loaded automatically on startup;
# real environment variables take precedence over values in the file.

# Seeds the super admin while the portal has no accounts yet. Nobody can sign
# themselves up, so this is the way in on a fresh install; everyone after that is
# invited. The default password must be changed at the first sign-in.
PORTAL_ADMIN_EMAIL=admin@localhost
PORTAL_ADMIN_PASSWORD=changeme
# Optional: a BCrypt hash instead of the plaintext above, e.g.
#   htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'
# Set, it wins, and no password change is forced at first sign-in.
PORTAL_ADMIN_PASSWORD_HASH=
# Name of the group that super admin administers
PORTAL_ADMIN_GROUP=Administrators

# Invitations. Without an SMTP server the portal still issues them and shows the
# link to the admin to pass on by hand.
PORTAL_BASE_URL=http://localhost:8080
PORTAL_MAIL_FROM=no-reply@example.com
PORTAL_INVITE_VALID_FOR=24h
#SPRING_MAIL_HOST=smtp.example.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=
#SPRING_MAIL_PASSWORD=
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Expiry reminders: emailed to a key's owner a month, two weeks, a week and a day
# before it expires. Uses the mail server and PORTAL_BASE_URL above. The cron is
# Spring's six-field form; the default is 08:00 every day.
PORTAL_EXPIRY_REMINDERS=true
PORTAL_EXPIRY_REMINDER_CRON=0 0 8 * * *

# Base64 encoded 256-bit AES key used to encrypt key values: openssl rand -base64 32
# Back this up - stored values can't be decrypted without it.
PORTAL_ENCRYPTION_KEY=

# Only needed for docker-compose / the "postgres" profile
PORTAL_DB_URL=jdbc:postgresql://localhost:5432/keyportal
PORTAL_DB_USERNAME=keyportal
PORTAL_DB_PASSWORD=
